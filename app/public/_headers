# Cloudflare Pages response headers.
# Bundles have a content hash in their names and index.html always references
# them, so they can be cached forever. index.html is never cached, so a new
# deploy is picked up on the next load.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
# Assets are hashed too, but a missing one is answered with index.html (the SPA
# fallback); a day's cache keeps such a mistake from sticking for a year.
/assets/*
  Cache-Control: public, max-age=86400
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
