# Cloudflare Pages response headers. Expo's bundles have content hashes in
# their names, so they can be cached forever; index.html is never cached, so a
# new deploy is picked up on the next load.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
